FLASK_ENV=development

DATABASE_URL_APP=sqlite:///app.db
#DATABASE_URL_APP=mysql+pymysql://USER:PASSWORD@localhost:3306/DATABASE

########################################
# LLM CONFIGURATION
########################################

# Provider: openai, gemini
LLM_PROVIDER=gemini

# Model name
LLM_MODEL=gemini-3.1-flash-lite

# API key for the selected provider
LLM_API_KEY=YOUR_API_TOKEN

# Optional: sampling temperature (default 0.8)
LLM_TEMPERATURE=0.8

########################################
# IMAGE GENERATOR CONFIGURATION
########################################

# Provider: gemini, openai
IMAGE_GENERATOR_PROVIDER=gemini

# Optional: Model name for image generation (defaults to imagen-3.0-generate-002 or dall-e-3)
IMAGE_GENERATOR_MODEL=gemini-3.1-flash-image

########################################
# EMAIL CONFIGURATION (Optional)
########################################

# SMTP Host (Defaults to 'localhost' for local sendmail/postfix)
SMTP_SERVER=localhost
SMTP_PORT=25

# Optional Credentials (Leave empty for local mail delivery)
SMTP_USER=
SMTP_PASSWORD=

# Default Sender Address
SMTP_FROM=agent@localhost